# Observability — Cloudflare Workers + Hono
APP_ENV=development

# Sentry (@sentry/cloudflare + SSRF-safe /monitoring tunnel)
SENTRY_DSN=
SENTRY_ALLOWED_HOST=
SENTRY_PROJECT_ID=

# PostHog (server-side ctx.waitUntil capture + /ingest reverse proxy)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
