# Observability — Vite + React + TanStack + Hono
VITE_OBSERVABILITY_DEBUG=false
VITE_GIT_SHA=

# Sentry
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (route browser traffic via first-party /ingest proxy)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.posthog.com
VITE_POSTHOG_PROXY=/ingest

# Optional: Microsoft Clarity (setting this auto-disables PostHog replay)
VITE_CLARITY_PROJECT_ID=
